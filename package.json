{
  "name": "maple-exp-tracker",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Lightweight screen-reading EXP / meso / drop tracker overlay for MapleStory Classic",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "replay": "node dev/replay.mjs"
  },
  "dependencies": {
    "idb-keyval": "6.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "puppeteer-core": "23.11.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
