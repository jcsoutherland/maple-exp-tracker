{
  "name": "maple-tracker-overlay",
  "productName": "MS Classic Tracker Overlay",
  "version": "1.6.0",
  "private": true,
  "description": "MS Classic Tracker Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "training.mapleclassic.overlay",
    "productName": "MS Classic Tracker Overlay",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "MS Classic Tracker Overlay",
        "schemes": [
          "mapleoverlay"
        ]
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MS Classic Tracker Overlay",
      "artifactName": "MapleTrackerOverlay-Setup.exe",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jcsoutherland",
        "repo": "maple-exp-tracker"
      }
    ]
  }
}
