{
  "name": "maple-tracker-overlay",
  "productName": "MS Classic Tracker Overlay",
  "version": "1.0.0",
  "private": true,
  "description": "Always-on-top overlay for the MS Classic Training Tracker (mapleclassic.training): linked to the website, or tracking on its own",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "training.mapleclassic.overlay",
    "productName": "MS Classic Tracker Overlay",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "MapleTrackerOverlay.exe",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    }
  }
}
